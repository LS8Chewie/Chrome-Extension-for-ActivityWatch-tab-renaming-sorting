{
  "manifest_version": 3,
  "name": "ActivityWatch Title Helper",
  "description": "Automatically prepend or append custom labels to tab titles based on the current URL.",
  "version": "1.0.0",

  "permissions": ["storage", "tabs"],
  "host_permissions": ["<all_urls>"],

  "options_page": "options/options.html",

  "background": {
    "service_worker": "scripts/background.js"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "scripts/default-rules.js",
        "scripts/rule-engine.js",
        "scripts/content.js"
      ],
      "run_at": "document_start"
    }
  ],

  "action": {
    "default_title": "ActivityWatch Title Rules",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}